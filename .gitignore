# Rust build output (the binary ships; the build dir does not)
/target/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local secrets — never commit
.env
*.pem
*.key
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
# The sqlite sidecars a `*.db` credential store can grow mid-write. The stores
# themselves are encrypted, but the journal is plaintext, and `*.db` does not
# match `credentials.db-journal`.
*.db-journal
*.db-wal
*.db-shm

# The `ar mcp` control-plane audit trail, written beside the config by
# `ar mcp`. Append-only, per-invocation, and worthless without a run behind it.
*.redb

# Profiling / fuzz artifacts
perf.data*
*.profraw

# Release staging (built artifacts, shipped via GitHub Releases)
/dist/
